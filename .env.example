# Copy to .env for local development. These credentials are for the local
# compose stack only and are deliberately not secret.
#
# The ports are off the defaults so a natively installed PostgreSQL or MinIO
# cannot be reached by accident. See compose.yaml.
DATABASE_URL=postgres://sandbox:sandbox@127.0.0.1:55432/sandbox

S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=sandbox
S3_SECRET_ACCESS_KEY=sandbox-dev-secret
S3_BUCKET=sandbox-dev

RUST_LOG=info,sandbox=debug
